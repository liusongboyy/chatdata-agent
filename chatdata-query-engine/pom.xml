<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.liusongboyy.chatdata</groupId>
        <artifactId>chatdata-agent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!--
      groupId 显式声明为 com.liusongboyy.chatdata，与 common-* 各库模块一致。
      根 pom（chatdata-agent）与 chatdata-query-service 用的是 com.liusongboyy——
      项目里两种写法并存。本模块是**库**，跟随库那一套。
    -->
    <groupId>com.liusongboyy.chatdata</groupId>
    <artifactId>chatdata-query-engine</artifactId>
    <packaging>jar</packaging>

    <name>chatdata-query-engine</name>
    <description>
        自研问数引擎：语义层 + NL2SQL + 数据源适配 + 助理 + 权限。
        自研引擎，见 docs/adr/0006 与 .scratch/self-built-chatbi/spec.md。

        包结构与各包的落地状态见 spec.md §8。
        注意该节历史快照曾一度过期——想知道某块做到哪，以代码和测试为准。
    </description>

    <dependencies>
        <!--
          本项目自己的持久层约定（MyBatis-Plus + Hikari）。
          引擎读语义配置走 Mapper，与本项目其余模块一致——
          单独引一个 ORM 会让团队多记一套用法，收益不抵成本。
        -->
        <dependency>
            <groupId>com.liusongboyy.chatdata</groupId>
            <artifactId>chatdata-common-mybatis</artifactId>
        </dependency>

        <!-- agentscope：agent 循环、工具调用、结构化输出、会话持久化。版本由根 pom 的 BOM 管理 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
        </dependency>
        <!--
          直连模式的表级白名单校验。**只用来读出 SQL 引用了哪些表**，不改写 SQL——
          改写方案见 docs/adr/0002（已否决）。
        -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
        </dependency>

        <!--
          会话状态存储（多轮追问）。agentscope 的 Memory 自 2.0.0 起废弃，
          改用 AgentStateStore；本工程用 MySQL 实现，复用应用自己的数据源。
        -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- SqlTools 需要 javax.sql.DataSource 与 JDBC 驱动类型 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!--
          其余方言的 JDBC 驱动。

          ## 为什么以前只有 MySQL

          方言（SqlDialect）先支持了 Oracle / PostgreSQL / SQLServer，
          但驱动没进来——于是**配了数据源、测试连接时才报
          「未安装该数据库驱动」**，而错误发生在用户已经以为配好了的时候。

          ## 为什么用 runtime scope

          编译期不需要它们的任何类：代码一律通过 DriverManager /
          java.sql 接口访问，不 import 厂商 API。用 runtime 让它们
          只进最终 jar，不参与编译。

          ## 为什么用 profile 而不是默认全带

          这些驱动加起来几十 MB（尤其 Hive 会拖进一整套 Hadoop 依赖）。
          默认全带会让每个部署都背着自己用不到的库。

          但**默认带上更安全**——缺驱动的失败发生在用户配置数据源的时候，
          而那时他已经在管理台里点了一圈，报错却是一句"未安装驱动"。
          权衡之后：常用的四个（PG / Oracle / SQLServer / StarRocks 走 MySQL 协议）
          默认带，大数据那三个（Hive / Trino）放 profile。
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 本模块是库，不是可执行应用：禁用 repackage，避免产出不可用的 fat jar -->
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      大数据方向的 JDBC 驱动。

      ## 为什么放 profile 而不是默认带

      Hive 的 JDBC 驱动会拖进一整套 Hadoop 依赖（几十 MB），
      而多数部署只连关系型库或 Doris/StarRocks。默认背着自己用不到的
      几十 MB 是浪费。

      ## 什么时候开

      要连 Hive 或 Trino 时加 `-Pbigdata`：

        mvn package -Pbigdata

      或者在自己的部署 pom 里显式引用对应驱动。
    -->
    <profiles>
        <profile>
            <id>bigdata</id>
            <dependencies>
                <dependency>
                    <groupId>org.apache.hive</groupId>
                    <artifactId>hive-jdbc</artifactId>
                    <version>4.0.1</version>
                    <scope>runtime</scope>
                    <!-- Hive JDBC 会拖入大量 Hadoop 依赖，且与 Spring Boot 的
                         logback / jackson 版本有冲突。排除掉这些——
                         我们只用它的 JDBC 驱动类，不需要它的日志与序列化实现 -->
                    <exclusions>
                        <exclusion>
                            <groupId>org.slf4j</groupId>
                            <artifactId>slf4j-log4j12</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>log4j</groupId>
                            <artifactId>log4j</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>ch.qos.logback</groupId>
                            <artifactId>logback-classic</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>io.trino</groupId>
                    <artifactId>trino-jdbc</artifactId>
                    <version>468</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

</project>