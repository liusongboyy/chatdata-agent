<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.liusongboyy.chatdata</groupId>
        <artifactId>chatdata-agent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>chatdata-agent-ask</artifactId>
    <packaging>jar</packaging>

    <name>chatdata-agent-ask</name>
    <description>问数服务：嵌入 JimuChatBI，实现 JmReportTokenServiceI，暴露问数 API</description>

    <properties>
        <jsqlparser.version>5.0</jsqlparser.version>
        <!--
          刻意不定义名为 mysql.version 的属性：Spring Boot 的 parent 用该名字管理
          com.mysql:mysql-connector-j 的版本，覆盖它会让所有无版本引用解析到一个
          在新坐标下并不存在的版本（如 8.0.27），报错却是"构件缺失"，极难定位。
        -->
    </properties>

    <repositories>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/nexus/content/groups/public</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- IAM 客户端：把不透明令牌换成主体（内省 + Redis 缓存）。
             ask 不再自己签发令牌，也不再查用户/角色表——那些都在 IAM。 -->
        <dependency>
            <groupId>com.liusongboyy.chatdata</groupId>
            <artifactId>chatdata-agent-iam-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          自研问数引擎。当前只为了让它随应用启动：
          引擎的 EngineStartupCheck 是 ApplicationRunner，会校验 ask_* 里的语义配置。
          取数链路尚未切过来——那是 ADR-0006 里挂起的切换决策。
        -->
        <dependency>
            <groupId>com.liusongboyy.chatdata</groupId>
            <artifactId>chatdata-agent-ask-engine</artifactId>
        </dependency>

        <!-- 版本由根 pom 的 dependencyManagement 管理 -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 数据库。驱动版本交给 Spring Boot 管理，不自行 pin。
             连接池用 common-mybatis 带的 HikariCP；druid 随厂商依赖一并移除了。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
