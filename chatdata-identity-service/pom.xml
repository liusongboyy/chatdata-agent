<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.liusongboyy.chatdata</groupId>
        <artifactId>chatdata-agent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>chatdata-identity-service</artifactId>
    <packaging>jar</packaging>

    <name>chatdata-identity-service</name>
    <description>
        用户、组织、角色、权限与登录的独立服务。
        认证授权走 OAuth 2.1（Spring Authorization Server），
        access token 使用不透明引用令牌（OAuth2TokenFormat.REFERENCE），
        授权记录落 MySQL、会话与缓存落 Redis。见 docs/adr/0008。
    </description>

    <dependencies>
        <!-- 本项目持久层约定（MyBatis-Plus + Hikari + MySQL） -->
        <dependency>
            <groupId>com.liusongboyy.chatdata</groupId>
            <artifactId>chatdata-common-mybatis</artifactId>
        </dependency>

        <!-- Web。登录页由 chatdata-identity-web（Vue）提供，不用服务端模板 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 健康检查。运维与探针要能问到"进程活着吗"。
             只暴露 health：metrics/env/heapdump 之类在公网入口上是信息泄露面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 会话落 Redis：IAM 多实例部署时，会话不能只在单机内存里 -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>

        <!-- 认证与授权服务器。
             Boot 4.1 同时提供旧名 starter（已标 deprecated）与新名，
             这里用旧名是因为它在本机仓库已存在且传递依赖完整；
             升级时只需换成 spring-boot-starter-security-oauth2-authorization-server。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-authorization-server</artifactId>
        </dependency>

        <!-- 会话、验证码、内省缓存、吊销广播 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              每次构建前重建 target 里的前端静态资源，避免旧 hash 文件堆积。

              Vite 的 emptyOutDir 会清空源目录，但 Maven 拷 resources 进
              target/classes 是增量的——旧 hash 的 js 永远留在那里并被打进 jar。
              实测这里积了 4 个。浏览器缓存到旧版本的表现是
              「代码改了但页面没变」，排查方向会被引向"是不是没构建"。

              自己「删 + 拷」而不是只删：与 Maven 资源拷贝同处
              process-resources 阶段，先后不写进契约；只删不拷可能导致
              jar 里**完全没有前端**，那比带着旧版本更糟。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>clean-stale-frontend-assets</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <delete dir="${project.build.outputDirectory}/static/iam/app"/>
                                <copy todir="${project.build.outputDirectory}/static/iam/app">
                                    <fileset dir="${project.basedir}/src/main/resources/static/iam/app"/>
                                </copy>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
