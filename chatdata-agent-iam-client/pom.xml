<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.liusongboyy.chatdata</groupId>
        <artifactId>chatdata-agent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>chatdata-agent-iam-client</artifactId>
    <packaging>jar</packaging>

    <name>chatdata-agent-iam-client</name>
    <description>
        给资源服务器（ask、渠道 worker）用：把 IAM 的不透明令牌换成主体。
        含 Redis 缓存；拿不到就拒绝（fail-closed），绝不回落成放行。
        见 docs/adr/0008 与 .scratch/iam-platform/spec.md §6.8。
    </description>

    <dependencies>
        <!-- OpaqueTokenIntrospector 接口在这里 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- RestClient（spring-web）+ 参数化类型反序列化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- 缓存：可选。没有 Redis 时传 null 也能工作，只是每次都问 IAM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
