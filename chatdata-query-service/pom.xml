<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.liusongboyy.chatdata</groupId>
        <artifactId>chatdata-agent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>chatdata-query-service</artifactId>
    <packaging>jar</packaging>

    <name>chatdata-query-service</name>
    <description>问数服务：SSE 流式问答、管理台 API、会话历史</description>

    <properties>
        <jsqlparser.version>5.0</jsqlparser.version>
        <!--
          刻意不定义名为 mysql.version 的属性：Spring Boot 的 parent 用该名字管理
          com.mysql:mysql-connector-j 的版本，覆盖它会让所有无版本引用解析到一个
          在新坐标下并不存在的版本（如 8.0.27），报错却是"构件缺失"，极难定位。
        -->
    </properties>

    <repositories>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/nexus/content/groups/public</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- IAM 客户端：把不透明令牌换成主体（内省 + Redis 缓存）。
             ask 不再自己签发令牌，也不再查用户/角色表——那些都在 IAM。 -->
        <dependency>
            <groupId>com.liusongboyy.chatdata</groupId>
            <artifactId>chatdata-identity-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          自研问数引擎。当前只为了让它随应用启动：
          引擎的 EngineStartupCheck 是 ApplicationRunner，会校验 ask_* 里的语义配置。
          取数链路尚未切过来——那是 ADR-0006 里挂起的切换决策。
        -->
        <dependency>
            <groupId>com.liusongboyy.chatdata</groupId>
            <artifactId>chatdata-query-engine</artifactId>
        </dependency>

        <!-- 版本由根 pom 的 dependencyManagement 管理 -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 健康检查。运维与探针要能问到"进程活着吗"。
             只暴露 health：metrics/env/heapdump 之类在公网入口上是信息泄露面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 数据库。驱动版本交给 Spring Boot 管理，不自行 pin。
             连接池用 common-mybatis 带的 HikariCP；druid 随厂商依赖一并移除了。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              每次构建前重建 target 里的前端静态资源，避免旧 hash 文件堆积。

              ## 为什么需要

              Vite 的 emptyOutDir 会清空 src/main/resources/static/app，
              但 Maven 把 resources 拷进 target/classes 时是**增量**的——
              旧 hash 的 index-XXXX.js 永远留在那里，然后被打进 jar。

              实测：源目录只有 1 个 js，target/classes 里积了 7 个。
              jar 里同时带着多个版本，浏览器缓存到旧的那个就表现为
              「代码改了但页面没变」，而排查方向会被引向"是不是没构建"。

              ## 为什么自己做「删 + 拷」而不是只删

              Maven 的资源拷贝与这个插件同处 process-resources 阶段，
              谁先谁后由 Maven 内部决定，不写进契约。只删不拷的话，
              一旦插件跑在拷贝之后，jar 里就**一点前端都没有**——
              那比带着旧版本更糟。

              所以这里自己拷贝，行为完全确定。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>clean-stale-frontend-assets</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <delete dir="${project.build.outputDirectory}/static/app"/>
                                <copy todir="${project.build.outputDirectory}/static/app">
                                    <fileset dir="${project.basedir}/src/main/resources/static/app"/>
                                </copy>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>


    </build>
</project>
