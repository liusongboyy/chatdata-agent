# ── 构建产物 ──
target/
!**/src/main/**/target/
!**/src/test/**/target/
build/
dist/
node_modules/
# 注意：src/main/resources/static/** 是前端构建产物，但**必须提交**。
# Maven 不构建前端（没有 frontend-maven-plugin），删了它 clone 下来就是白屏。
# 改了前端要手动 npm run build 再提交，见 CONTRIBUTING.md

# ── 密钥与本地配置（绝不要提交）──
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.jks
secrets.*
!**/src/**/test/**/secrets.*

# ── IDE ──
# 整个 .idea/ 都不该进库：workspace.xml 每次打开项目都变，会给每个 PR 制造无关 diff
.idea/
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
*.iws
*.iml
*.ipr
.vscode/
.settings/
.classpath
.project
.classpath
.factorypath
.springBeans
.sts4-cache

# ── 系统 ──
.DS_Store
*.log
.gstack/
Thumbs.db

# ── 评测本地产物 ──
eval/fixture/*.local.sql
.scratch/
