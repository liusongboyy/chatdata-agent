# =====================================================================
# 复制成 .env 后填入真实值：cp .env.example .env
# 这个文件会被 .gitignore 忽略，**绝不要提交 .env**
# =====================================================================

# ── 数据库 ──
# 四个库按职责分开，见 sql/README.md
# 用 docker compose 起的库在 13306；本机自装的 MySQL 通常是 3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DB=chatdata_ask
IAM_DB=chatdata_iam

# ── Redis（会话 / 验证码 / 缓存）──
# 同样：docker compose 起在 16379
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# ── LLM 提供方 ──
# 任何 OpenAI 兼容的端点都行（OpenAI / DeepSeek / 通义 / Ark 等）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-change-me
LLM_MODEL=gpt-4o-mini

# ── 服务间密钥（自己在本地生成，不要复用示例值）──
# 生成：openssl rand -base64 32
CHATDATA_AUTH_SECRET=change-me-32-bytes
IAM_BFF_SECRET=change-me-32-bytes
IAM_RESOURCE_SECRET=change-me-32-bytes
# 数据源密码加密用；改了这个值，已存的密码密文全部解不开
CHATDATA_ENGINE_DS_SECRET=change-me-32-bytes
# 渠道换取「代表用户」的令牌。与 IAM 里的 channel-bot 客户端一致
IAM_CHANNEL_SECRET=change-me-32-bytes

# ── 飞书渠道（可选，不接飞书就保持 ENABLED=false）──
# 完整步骤见 docs/feishu-channel-setup.md
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 事件加密密钥。**启用渠道后必填**——不配则事件明文传输，body 含提问原文与 open_id
FEISHU_ENCRYPT_KEY=
# 回调地址校验用（选填）
FEISHU_VERIFICATION_TOKEN=
# 用户点「立即绑定」时浏览器打开的地址（网关），不是飞书回调地址
BIND_BASE_URL=http://127.0.0.1:8080

# ── 端口（本地默认，冲突时改这里）──
GATEWAY_PORT=8080
ASK_PORT=8081
IAM_PORT=9000
CHANNEL_PORT=20000
